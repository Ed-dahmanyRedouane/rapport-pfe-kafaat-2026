@startuml

skinparam ActivityBackgroundColor #E8F4FD
skinparam ActivityBorderColor #1A6DAF
skinparam ActivityDiamondBackgroundColor #D6EAF8
skinparam ActivityDiamondBorderColor #1A6DAF
skinparam ActivityArrowColor #1A6DAF
skinparam defaultFontColor #0A2540
skinparam PartitionBackgroundColor #EBF5FB
skinparam PartitionBorderColor #1A6DAF
skinparam PartitionFontColor #1A6DAF
skinparam PartitionFontSize 13
skinparam PartitionFontStyle bold
skinparam roundcorner 10
skinparam shadowing true

title Plateforme KAFA'AT EMS — Gestion et Recouvrement des Factures

|#EBF5FB|Administrateur|
start
:Accéder au module de facturation;
:Consulter la liste générale des factures;

|#E8F4FD|Système|
if (Une facture spécifique est-elle sélectionnée ?) then (Non)
  #D6EAF8:Générer l'export global\ndes données (Fichier Excel / CSV);
  |#EBF5FB|Administrateur|
  :Télécharger le rapport Excel;
  kill
else (Oui)
  |#E8F4FD|Système|
  :Afficher les détails de la facture\n(Client, Montant, Échéance, Statut);
endif

|#EBF5FB|Administrateur|
if (Action souhaitée ?) then (Enregistrer paiement)
  :Saisir les références du paiement\n(Mode de paiement, Date, Montant exact);
  |#E8F4FD|Système|
  :Valider les données saisies;
  #AED6F1:Mettre à jour le statut\nStatut = PAYEE;
  :Générer le reçu de paiement (PDF);

elseif (Action souhaitée ?) then (Vérifier et Relancer)
  |#E8F4FD|Système|
  if (Le statut actuel est-il EN_ATTENTE ?) then (Oui)
    if (Date actuelle > Date d'échéance ?) then (Oui)
      #FFCCCC:Mettre à jour le statut\nStatut = EN_RETARD;
      :Déclencher l'envoi d'un email\nde relance automatique au client;
    else (Non)
      #D6EAF8:Aucune action requise\n(La facture est encore dans les délais);
    endif
  else (Non)
    #FFCCCC:Action impossible\n(Facture déjà soldée ou annulée);
  endif

else (Télécharger document)
  |#E8F4FD|Système|
  :Récupérer le flux binaire du fichier\ndepuis le serveur de stockage;
  |#EBF5FB|Administrateur|
  #D6EAF8:Télécharger et ouvrir\nla facture PDF originale;
endif

|#E8F4FD|Système|
#AED6F1:Mettre à jour le journal d'audit\n(Traçabilité de l'action effectuée);
stop

@enduml