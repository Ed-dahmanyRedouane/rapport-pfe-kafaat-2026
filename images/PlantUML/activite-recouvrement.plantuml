@startuml

skinparam Padding 18
skinparam arrowThickness 2
skinparam ActivityBorderThickness 2
skinparam PartitionBorderThickness 2

skinparam defaultFontSize 18
skinparam defaultFontStyle bold
skinparam ActivityFontSize 18
skinparam ActivityFontStyle bold
skinparam ActivityDiamondFontSize 18
skinparam ActivityDiamondFontStyle bold
skinparam ArrowFontSize 13
skinparam ArrowFontStyle bold

skinparam ActivityBackgroundColor #E8F4FD
skinparam ActivityBorderColor #1A6DAF
skinparam ActivityDiamondBackgroundColor #D6EAF8
skinparam ActivityDiamondBorderColor #1A6DAF
skinparam ActivityArrowColor #1A6DAF
skinparam defaultFontColor #0A2540
skinparam PartitionBackgroundColor #EBF5FB
skinparam PartitionBorderColor #1A6DAF
skinparam PartitionFontColor #1A6DAF
skinparam PartitionFontSize 16
skinparam PartitionFontStyle bold
skinparam roundcorner 10
skinparam shadowing true

title Plateforme KAFA'AT EMS — Gestion et Recouvrement des Factures

|#EBF5FB|Administrateur|
start
:Consulter les détails d'une facture\n(Sélectionnée depuis la liste);

if (Action souhaitée ?) then (Enregistrer paiement)
  :Saisir les références\n(Mode, Date, Montant);
  |#E8F4FD|Système|
  :Valider les données;
  #AED6F1:Mettre à jour le statut (PAYEE);
  :Générer le reçu PDF;

elseif (Action souhaitée ?) then (Vérifier et Relancer)
  |#E8F4FD|Système|
  if (Statut = EN_ATTENTE et Date > Échéance ?) then (Oui)
    #FFCCCC:Mettre à jour le statut (EN_RETARD);
    :Envoyer l'email de relance automatique;
  else (Non)
    #D6EAF8:Action ignorée\n(Facture soldée ou dans les délais);
  endif

else (Télécharger)
  |#E8F4FD|Système|
  :Préparer le document original;
  |#EBF5FB|Administrateur|
  #D6EAF8:Télécharger la facture PDF;
endif

|#E8F4FD|Système|
#AED6F1:Enregistrer l'action effectuée\ndans le journal d'audit;
stop

@enduml